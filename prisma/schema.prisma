// Prisma Schema for FloodVision Platform - SIH26085 Master Upgrade

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("USER") // USER or ADMIN
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  locations     Location[]
  notifications Notification[]
}

model Location {
  id         String      @id @default(uuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  latitude   Float
  longitude  Float
  city       String?
  state      String?
  country    String?
  isHome     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  floodRisks FloodRisk[]
}

model FloodRisk {
  id           String    @id @default(uuid())
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  latitude     Float
  longitude    Float
  riskScore    Float     // 0 - 100
  probability  Float     // 0.0 - 1.0
  riskLevel    String    // LOW, MODERATE, HIGH, CRITICAL
  confidence   Float     // 0.0 - 1.0
  rainfall     Float     // mm
  waterLevel   Float     // meters
  temperature  Float     // °C
  humidity     Float?    // %
  soilMoisture Float?    // %
  createdAt    DateTime  @default(now())
}

model FloodAlert {
  id            String         @id @default(uuid())
  title         String
  description   String
  severity      String         // INFO, WARNING, DANGER, CRITICAL
  latitude      Float
  longitude     Float
  radiusKm      Float          @default(10.0)
  affectedArea  String
  expiresAt     DateTime
  createdAt     DateTime       @default(now())
  notifications Notification[]
}

model Notification {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId   String
  alert     FloodAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  read      Boolean    @default(false)
  createdAt DateTime   @default(now())
}

model WeatherData {
  id          String   @id @default(uuid())
  latitude    Float
  longitude   Float
  temperature Float
  humidity    Float
  rainfall    Float
  windSpeed   Float
  condition   String
  timestamp   DateTime @default(now())
}

model FloodEvent {
  id          String   @id @default(uuid())
  location    String
  latitude    Float
  longitude   Float
  severity    String   // LOW, MODERATE, HIGH, CRITICAL
  description String
  impact      String?
  date        DateTime
  createdAt   DateTime @default(now())
}

model MonitoringStation {
  id            String   @id @default(uuid())
  name          String
  latitude      Float
  longitude     Float
  waterLevel    Float    // in meters
  warningLevel  Float    // threshold for alert
  criticalLevel Float    // threshold for critical
  status        String   // OPERATIONAL, WARNING, CRITICAL, OFFLINE
  lastUpdated   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("PENDING") // PENDING, RESOLVED
  createdAt DateTime @default(now())
}

// ==========================================
// SIH26085 GIS & HYDRAULICS EXTENDED MODELS
// ==========================================

model Road {
  id           String        @id @default(uuid())
  name         String
  category     String        // HIGHWAY, ARTERIAL, RESIDENTIAL
  geometryJson String        // GeoJSON LineString [ [lng, lat], ... ]
  elevation    Float         // meters
  slope        Float         // percentage
  segments     RoadSegment[]
}

model RoadSegment {
  id           String                  @id @default(uuid())
  roadId       String
  road         Road                    @relation(fields: [roadId], references: [id], onDelete: Cascade)
  startLat     Float
  startLng     Float
  endLat       Float
  endLng       Float
  lengthMeters Float
  surfaceType  String                  // ROAD, CONCRETE, PARK, SOIL
  predictions  FloodPredictionRecord[]
}

model DrainNode {
  id            String      @id @default(uuid())
  name          String
  type          String      // MANHOLE, INLET, JUNCTION, OUTFALL
  latitude      Float
  longitude     Float
  elevation     Float
  capacityM3s   Float
  outgoingEdges DrainEdge[] @relation("FromNode")
  incomingEdges DrainEdge[] @relation("ToNode")
}

model DrainEdge {
  id          String    @id @default(uuid())
  fromNodeId  String
  fromNode    DrainNode @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId    String
  toNode      DrainNode @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  diameterM   Float
  lengthM     Float
  capacityM3s Float
  roughnessN  Float     @default(0.013)
}

model FloodPredictionRecord {
  id            String      @id @default(uuid())
  segmentId     String
  segment       RoadSegment @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  forecastMin   Int         // 0, 30, 60, 90, 120, 150, 180
  depthCm       Float
  probability   Float
  riskLevel     String      // LOW, MODERATE, HIGH, CRITICAL, DARK_RED
  surchargeLoad Float       // %
  recommendation String
  createdAt     DateTime    @default(now())
}

// ==========================================
// FLOODWATCH - COMMUNITY WATERLOGGING MODELS
// ==========================================

model WaterloggingReport {
  id               String       @id @default(uuid())
  latitude         Float
  longitude        Float
  streetName       String
  landmark         String?
  city             String       @default("Mumbai")
  depthCategory    String       // ANKLE, KNEE, WAIST, SUBMERGED
  depthCm          Float
  waterLevelTrend  String       @default("UNKNOWN") // RISING, STABLE, FALLING, UNKNOWN
  roadCondition    String       @default("UNKNOWN") // PASSABLE, DIFFICULT, BLOCKED, UNKNOWN
  hazardTags       String       @default("[]") // JSON string: ["OPEN_MANHOLE", "STALLED_VEHICLE"]
  description      String?
  photoUrl         String?
  upvotes          Int          @default(1)
  status           String       @default("UNVERIFIED") // UNVERIFIED, VERIFIED, RESOLVED, STALE
  isStale          Boolean      @default(false)
  priorityScore    Float        @default(0.0) // 0 - 100 calculated
  isDuplicate      Boolean      @default(false)
  parentReportId   String?
  hotspotId        String?
  hotspot          Hotspot?     @relation(fields: [hotspotId], references: [id], onDelete: SetNull)
  reportedBy       String?      @default("Citizen Reporter")
  verifiedAt       DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  actions          IncidentAction[]
}

model Hotspot {
  id               String               @id @default(uuid())
  title            String
  centerLat        Float
  centerLng        Float
  radiusMeters     Float                @default(300.0)
  reportCount      Int                  @default(1)
  maxDepthCategory String               @default("KNEE")
  maxDepthCm       Float                @default(30.0)
  priorityScore    Float                @default(50.0)
  status           String               @default("ACTIVE") // ACTIVE, MONITORING, RESOLVED
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  reports          WaterloggingReport[]
  actions          IncidentAction[]
}

model IncidentAction {
  id          String              @id @default(uuid())
  reportId    String?
  report      WaterloggingReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)
  hotspotId   String?
  hotspot     Hotspot?            @relation(fields: [hotspotId], references: [id], onDelete: Cascade)
  actionType  String              // STATUS_CHANGE, VERIFY, RESOLVE, MERGE_DUPLICATE, DISPATCH_CREW, NOTE
  actorName   String              @default("Municipal Operator")
  notes       String
  createdAt   DateTime            @default(now())
}
